NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Backend only: direct OpenAI, separate from Azure deployment names.
STUDYMATE_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional legacy Azure provider: set STUDYMATE_AI_PROVIDER=azure to use it.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

FOUNDRY_IQ_ENDPOINT=
FOUNDRY_IQ_KEY=
FOUNDRY_IQ_KNOWLEDGE_BASE=

AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# Use false for real Supabase login and mobile API requests.
NEXT_PUBLIC_DEMO_MODE=false

# Backend only. RevenueCat REST API v1 secret key for server entitlement checks.
REVENUECAT_SECRET_API_KEY=
# Comma-separated Supabase UUIDs allowed to exercise sandbox Pro access.
# Empty by default: sandbox purchases do not unlock paid backend actions.
REVENUECAT_SANDBOX_USER_IDS=

# Apply 20261001_usage_credits_schools.sql before enabling quotas.
STUDYMATE_METERING_ENABLED=false
# Approved school owners can create one capped 30-day pilot each.
STUDYMATE_SCHOOL_PILOT_USER_IDS=
# Server-only webhook Authorization value; configure the same value in RevenueCat.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ALLOWED_APP_IDS=
REVENUECAT_CREDIT_PRODUCT_IDS=studymate_sessions_10_test_v1
