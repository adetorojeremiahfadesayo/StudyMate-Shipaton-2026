NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Backend only: direct OpenAI, separate from Azure deployment names.
STUDYMATE_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional legacy Azure provider: set STUDYMATE_AI_PROVIDER=azure to use it.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

FOUNDRY_IQ_ENDPOINT=
FOUNDRY_IQ_KEY=
FOUNDRY_IQ_KNOWLEDGE_BASE=

AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=

# Use false for real Supabase login and mobile API requests.
NEXT_PUBLIC_DEMO_MODE=false

# Backend only. RevenueCat REST API v1 secret key for server entitlement checks.
REVENUECAT_SECRET_API_KEY=
# Comma-separated Supabase UUIDs allowed to exercise sandbox Pro access.
# Empty by default: sandbox purchases do not unlock paid backend actions.
REVENUECAT_SANDBOX_USER_IDS=
